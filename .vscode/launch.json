    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": " --config gaia_config2.yaml",
            "env": {
                "CHECKPOINT_PATH": "./data/middle/checkpoints/service_model.pt",
                "DYNACONF_PATHS__METADATA": "./data/middle/metadata",
                "DYNACONF_PATHS__CKPT": "./data/middle/checkpoints",
                "RCABENCH_BASE_URL": "http://10.10.10.220:32080",
                "RCABENCH_USERNAME": "admin",
                "RCABENCH_PASSWORD": "admin123"
            }
        },
        {
            "name": "Python Debugger: Test",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": " batch-test --label 9.10run",
            "justMyCode": false,
            "env": {
                "CHECKPOINT_PATH": "./data/middle/checkpoints/service_model.pt",
                "DYNACONF_PATHS__METADATA": "./data/middle/metadata",
                "DYNACONF_PATHS__CKPT": "./data/middle/checkpoints",
                "RCABENCH_BASE_URL": "http://10.10.10.220:32080",
                "RCABENCH_USERNAME": "admin",
                "RCABENCH_PASSWORD": "admin123"
            }
        }
    ]
